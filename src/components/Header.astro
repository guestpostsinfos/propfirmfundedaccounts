---
import { NAV, SITE } from '../consts';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label={SITE.name}>Prop Firm <span>Funded Accounts</span></a>
    <nav class="site-nav" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'true' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
