---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { AUTHOR, CATEGORIES, SITE } from '../consts';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { title, description, category, pubDate, updatedDate, directAnswer, takeaways, faqs, review } =
  entry.data;

const url = `${SITE.url}/${category}/${entry.id}/`;
const catInfo = CATEGORIES[category];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// --- structured data -------------------------------------------------------
const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: url,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    jobTitle: AUTHOR.role,
    url: `${SITE.url}${AUTHOR.url}`,
  },
  publisher: { '@id': `${SITE.url}/#organization` },
};

const schema: object[] = [articleSchema];

if (review) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: {
      '@type': 'FinancialService',
      name: review.firm,
    },
    reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
    author: { '@type': 'Person', name: AUTHOR.name },
    publisher: { '@id': `${SITE.url}/#organization` },
  });
}

if (faqs.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

schema.push({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: catInfo.title, item: `${SITE.url}/${category}/` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
});

// --- related articles (same category, newest first) ------------------------
const all = await getCollection('articles', ({ data }) => !data.draft);
const related = all
  .filter((a) => a.id !== entry.id && a.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const initials = AUTHOR.name
  .split(' ')
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
---

<Base
  title={title.length > 50 ? title : `${title} | ${SITE.name}`}
  description={description}
  schema={schema}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href={`/${category}/`}>{catInfo.title}</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <header class="article-head">
      <h1>{title}</h1>
      <p class="article-meta">
        <span>By <a href={AUTHOR.url}>{AUTHOR.name}</a></span>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>Published {fmt(pubDate)}</time>
        {updatedDate && (
          <>
            <span>·</span>
            <time class="updated" datetime={updatedDate.toISOString()}>
              Updated {fmt(updatedDate)}
            </time>
          </>
        )}
      </p>
    </header>

    {directAnswer && (
      <div class="direct-answer">
        <strong>Quick answer:</strong> {directAnswer}
      </div>
    )}

    {review && (
      <aside class="review-box">
        <div class="review-top">
          <span class="firm">{review.firm}</span>
          <span class="score">{review.rating.toFixed(1)}<small>/5</small></span>
        </div>
        <p class="review-facts">
          <strong>Founded:</strong> {review.founded} &nbsp;·&nbsp; <strong>Best for:</strong>{' '}
          {review.bestFor}
        </p>
        <div class="pros-cons">
          <div class="pros">
            <h3>Pros</h3>
            <ul>{review.pros.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div class="cons">
            <h3>Cons</h3>
            <ul>{review.cons.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>
      </aside>
    )}

    {takeaways.length > 0 && (
      <aside class="takeaways">
        <h2>Key takeaways</h2>
        <ul>{takeaways.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}

    <article class="article-body">
      <slot />
    </article>

    {faqs.length > 0 && (
      <section class="faq">
        <h2>Frequently asked questions</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </section>
    )}

    <aside class="author-box">
      <div class="avatar" aria-hidden="true">{initials}</div>
      <div>
        <strong>{AUTHOR.name}</strong> — {AUTHOR.role}
        <br />
        {AUTHOR.bio} <a href="/methodology/">Read our review methodology →</a>
      </div>
    </aside>

    {related.length > 0 && (
      <section class="related">
        <h2>Keep reading</h2>
        <ul class="card-grid">
          {related.map((r) => <ArticleCard entry={r} />)}
        </ul>
      </section>
    )}
  </div>
</Base>
