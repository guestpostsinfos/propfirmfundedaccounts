---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import {
  leaderboard,
  topMovers,
  marketSummary,
  latestWeek,
  weekLabel,
  UPDATED,
  FIRMS,
} from '../data/trustpilot.mjs';

const url = `${SITE.url}/prop-firm-leaderboard/`;
const board = leaderboard();
const movers = topMovers();
const summary = marketSummary();
const latest = latestWeek();
const weekOf = latest ? weekLabel(latest.weekOf) : '';

const fmtInt = (n) => (n == null ? '—' : n.toLocaleString('en-US'));
const signed = (n) => (n > 0 ? `+${n}` : `${n}`);

const trendLabel = { up: 'Rising', down: 'Falling', steady: 'Steady', new: 'New' };

const top = board[0];
const faqs = [
  {
    q: 'What is a prop firm leaderboard?',
    a: 'A prop firm leaderboard ranks proprietary trading firms against each other so you can see, at a glance, which firms are performing best right now. This one ranks every major prop firm by its live Trustpilot rating and updates every week, showing which firms are rising and which are falling.',
  },
  {
    q: 'Which prop firm is ranked number 1 right now?',
    a: top
      ? `As of the week of ${weekOf}, ${top.name} tops the leaderboard with a Trustpilot TrustScore of ${top.score.toFixed(1)}/5 from ${top.reviews != null ? top.reviews.toLocaleString('en-US') : 'thousands of'} reviews. The ranking is recalculated every week, so the #1 firm can change — check the table above for the current order.`
      : 'The table above shows the current #1 firm; the ranking is recalculated every week.',
  },
  {
    q: 'How are prop firms ranked on this leaderboard?',
    a: 'By current Trustpilot TrustScore, highest first, with total review volume as the tie-breaker — a 4.8 from 40,000 reviews is more meaningful than a 4.8 from 400. A firm whose rating rose since last week moves up and is flagged as rising; a firm whose rating fell moves down and is flagged as falling.',
  },
  {
    q: 'How often is the prop firm leaderboard updated?',
    a: 'Every week. We record each firm’s Trustpilot TrustScore and total review count, then compare it to the previous reading so you can see which prop firms are climbing and which are slipping. The date at the top of the page shows the latest snapshot.',
  },
  {
    q: 'Are these the real prop firm ratings?',
    a: 'Yes. The TrustScores and review counts are the real, publicly reported figures for each firm’s verified Trustpilot page, cross-checked across sources. Each firm page links directly to its live Trustpilot profile so you can read the underlying reviews yourself.',
  },
  {
    q: 'Is the highest-ranked prop firm the best one for me?',
    a: 'Not necessarily. This leaderboard ranks firms on customer sentiment, which is useful but gameable — a wave of positive reviews can mask a recent rule or payout change. For the best firm for your strategy, read this alongside our hands-on best prop firms ranking and reviews, which weight documented payout reliability and rule fairness above sentiment.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    name: 'Prop Firm Leaderboard — Weekly Live Rankings & Performance',
    description:
      'A live, weekly-updated prop firm leaderboard ranking every major proprietary trading firm by real Trustpilot rating and performance, with this week’s biggest risers and fallers.',
    url,
    isPartOf: { '@id': `${SITE.url}/#website` },
    dateModified: UPDATED,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Prop firm leaderboard — firms ranked by rating',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: board.length,
    itemListElement: board.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${r.name} — ${r.score != null ? r.score.toFixed(1) + '/5' : 'rated'}`,
      url: `${SITE.url}/trustpilot-reviews/${r.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Prop Firm Leaderboard', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="Prop Firm Leaderboard Weekly – Live Rankings & Performance"
  description="The weekly prop firm leaderboard: every major prop trading firm ranked live by real Trustpilot rating and performance, with the biggest risers and fallers."
  schema={schema}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Prop Firm Leaderboard</li>
      </ol>
    </nav>
  </div>

  <header class="tp-hero">
    <div class="wrap">
      <span class="badge">Live weekly leaderboard · Real Trustpilot data</span>
      <h1>Prop Firm Leaderboard — Weekly Live Rankings &amp; Performance</h1>
      <p class="lede">
        The live <strong>prop firm leaderboard</strong>: every major proprietary trading firm
        ranked head-to-head by its real Trustpilot rating and performance, refreshed every week. See
        the current <strong>prop firm rankings</strong> at a glance —
        <strong>which firms are climbing and which are slipping</strong> — with this week's biggest
        risers and fallers. Ratings are the real, publicly reported figures; each firm links to its
        live Trustpilot page and full review. Looking for our hand-tested editorial pick instead?
        See the <a href="/best/best-prop-firms/">best prop firms</a> ranking.
      </p>
      <p class="tp-week">
        This week's leaderboard: <strong>Week of {weekOf}</strong> · {summary.count} prop firms
        ranked{top ? <> · #1 <strong>{top.name}</strong> ({top.score.toFixed(1)}/5)</> : null}
      </p>
    </div>
  </header>

  <div class="wrap tp-wrap">
    <!-- ===== SUMMARY STRIP ===== -->
    <section class="tp-summary" aria-label="This week at a glance">
      <div class="tp-stat">
        <span class="l">Average TrustScore</span>
        <span class="v">{summary.avg.toFixed(2)}<small>/5</small></span>
      </div>
      <div class="tp-stat">
        <span class="l">Total reviews tracked</span>
        <span class="v">{fmtInt(summary.totalReviews)}</span>
      </div>
      <div class="tp-stat">
        <span class="l">Highest rated</span>
        <span class="v">{summary.topRated ? summary.topRated.score.toFixed(1) : '—'}<small>/5</small></span>
        {summary.topRated && <span class="tp-stat-sub">{summary.topRated.name}</span>}
      </div>
      <div class="tp-stat">
        <span class="l">Firms tracked</span>
        <span class="v">{summary.count}</span>
      </div>
    </section>

    <!-- ===== MOVERS ===== -->
    {(movers.riser || movers.faller) && (
      <section class="tp-movers" aria-label="Biggest rating movers">
        {movers.riser && (
          <div class="mover up">
            <span class="m-tag">▲ Biggest riser</span>
            <a href={`/trustpilot-reviews/${movers.riser.slug}/`}>{movers.riser.name}</a>
            <span class="m-detail">
              TrustScore {movers.riser.prevScore?.toFixed(1)} → {movers.riser.score.toFixed(1)}
              ({signed(movers.riser.scoreDelta)}) since last reading
            </span>
          </div>
        )}
        {movers.faller && (
          <div class="mover down">
            <span class="m-tag">▼ Biggest faller</span>
            <a href={`/trustpilot-reviews/${movers.faller.slug}/`}>{movers.faller.name}</a>
            <span class="m-detail">
              TrustScore {movers.faller.prevScore?.toFixed(1)} → {movers.faller.score.toFixed(1)}
              ({signed(movers.faller.scoreDelta)}) since last reading
            </span>
          </div>
        )}
      </section>
    )}

    <!-- ===== LEADERBOARD ===== -->
    <section aria-label="Prop firm leaderboard — firms ranked by rating">
      <h2>This week's prop firm leaderboard</h2>
      <p class="tp-note">
        The full prop firm rankings, ordered by current TrustScore (review volume breaks ties). The
        arrow shows the change versus the previous reading — firms whose rating rose climb the
        leaderboard, firms whose rating fell drop down.
      </p>
      <div class="tp-table-wrap">
        <table class="tp-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Prop firm</th>
              <th>Market</th>
              <th>TrustScore</th>
              <th>Change</th>
              <th>Reviews</th>
              <th>Trend</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {board.map((r) => (
              <tr>
                <td class="c-rank">
                  {r.rank}
                  {r.rankDelta != null && r.rankDelta !== 0 && (
                    <span class={`rankmove ${r.rankDelta > 0 ? 'up' : 'down'}`}>
                      {r.rankDelta > 0 ? `▲${r.rankDelta}` : `▼${Math.abs(r.rankDelta)}`}
                    </span>
                  )}
                </td>
                <td class="c-firm">
                  <a href={`/trustpilot-reviews/${r.slug}/`}>{r.name}</a>
                </td>
                <td><span class={`mkt mkt-${r.market}`}>{r.market}</span></td>
                <td class="c-score">
                  {r.score != null ? r.score.toFixed(1) : '—'}
                  <span class="s5">/5</span>
                </td>
                <td class={`c-delta ${r.trend}`}>
                  {r.scoreDelta == null
                    ? '—'
                    : r.scoreDelta === 0
                      ? '±0'
                      : r.scoreDelta > 0
                        ? `▲ +${r.scoreDelta.toFixed(1)}`
                        : `▼ ${r.scoreDelta.toFixed(1)}`}
                </td>
                <td class="c-reviews">{fmtInt(r.reviews)}</td>
                <td>
                  <span class={`trend trend-${r.trend}`}>{trendLabel[r.trend]}</span>
                </td>
                <td class="c-cta">
                  <a class="view" href={`/trustpilot-reviews/${r.slug}/`}>Reviews &amp; rating →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ===== FIRM CARDS ===== -->
    <section class="tp-cards-sec" aria-label="Per-firm Trustpilot pages">
      <h2>Every prop firm's Trustpilot reviews &amp; rating</h2>
      <ul class="tp-cards">
        {board.map((r) => (
          <li class="tp-card">
            <div class="tc-head">
              <a class="tc-name" href={`/trustpilot-reviews/${r.slug}/`}>{r.name}</a>
              <span class={`trend trend-${r.trend}`}>{trendLabel[r.trend]}</span>
            </div>
            <div class="tc-score">
              <span class="stars" aria-hidden="true" style={`--pct:${(r.score / 5) * 100}%`}>★★★★★</span>
              <strong>{r.score != null ? r.score.toFixed(1) : '—'}</strong>
              <span class="tc-rev">{fmtInt(r.reviews)} reviews</span>
            </div>
            <a class="tc-link" href={`/trustpilot-reviews/${r.slug}/`}>
              {r.name} Trustpilot reviews &amp; rating →
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- ===== HOW IT WORKS ===== -->
    <section class="tp-explainer" aria-label="How the prop firm leaderboard works">
      <h2>How the prop firm leaderboard works</h2>
      <p>
        The leaderboard ranks the biggest forex and futures prop firms —
        <strong>FTMO, FundedNext, FundingPips, The5ers, Topstep, Apex, MyFundedFutures, Take Profit
        Trader, E8 Markets and Alpha Capital Group</strong>. Once a week we record each firm's
        Trustpilot <strong>TrustScore</strong> (the 1–5 rating) and its <strong>total review
        count</strong> from its verified Trustpilot page, and store the snapshot. Each week we take a
        fresh reading and compare TrustScores: a firm whose rating <em>rose</em> climbs the
        leaderboard, a firm whose rating <em>fell</em> drops down. Review count is shown as a
        credibility signal — a 4.8 from 40,000 reviews carries more weight than a 4.8 from a few
        hundred.
      </p>
      <p class="tp-baseline">
        This is the tracker's first published week, so the change column compares each firm's current
        TrustScore to its previous publicly reported figure (baseline dates vary by firm — some are a
        few weeks old). From next week onward, every comparison is a true seven-day, week-over-week
        move.
      </p>
      <p>
        Trustpilot is customer sentiment, not a solvency check. It is genuinely useful — a sudden
        slide in a firm's score is often the earliest public signal of a payout delay or an
        unpopular rule change — but it is also gameable, since firms can prompt happy customers for
        reviews. That's why we pair every score with our own hands-on
        <a href="/reviews/">prop firm reviews</a>, which weight documented payout reliability and
        rule fairness above raw sentiment (see our <a href="/methodology/">methodology</a>).
      </p>
      <p class="tp-disclaimer">
        <strong>On the review highlights:</strong> Trustpilot's terms don't allow us to republish
        individual reviews, so each firm page summarises the <em>recurring themes</em> — what
        reviewers most often praise and complain about — and links you to the live Trustpilot page
        to read the reviews in full. Ratings and counts are real, publicly reported figures; nothing
        is fabricated.
      </p>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="faq" aria-label="Frequently asked questions">
      <h2>Prop firm leaderboard — FAQ</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="faq-a"><p set:html={f.a} /></div>
        </details>
      ))}
    </section>

    <section class="tp-next" aria-label="Next steps">
      <ul class="card-grid">
        <li class="card"><span class="cat">Go deeper</span><h3><a href="/reviews/">Hands-on prop firm reviews</a></h3><p>Our own tested reviews — payout proof and rule fairness, not just sentiment.</p></li>
        <li class="card"><span class="cat">Compare</span><h3><a href="/best/best-prop-firms/">Best prop firms 2026</a></h3><p>Ranked on reliability first — the firms most likely to fund you and pay.</p></li>
        <li class="card"><span class="cat">Understand</span><h3><a href="/methodology/">Our methodology</a></h3><p>How we score firms, and why Trustpilot is only one input.</p></li>
      </ul>
    </section>
  </div>

  <style>
    .tp-hero { background: var(--brand-tint); border-bottom: 1px solid var(--line); padding: 2.5rem 0 2rem; }
    .tp-hero .badge { display: inline-block; background: #fff; border: 1px solid var(--brand); color: var(--brand-dark); font-weight: 700; font-size: 0.78rem; padding: 0.25rem 0.7rem; border-radius: 999px; margin-bottom: 0.75rem; }
    .tp-hero h1 { max-width: 20ch; }
    .tp-hero .lede { font-size: 1.15rem; color: var(--ink-soft); max-width: 64ch; margin: 0.5rem 0 1rem; }
    .tp-week { font-size: 0.95rem; color: var(--ink-soft); margin: 0; }
    .tp-wrap { padding-bottom: 2rem; }

    .tp-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin: 2rem 0; }
    .tp-stat { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 0.85rem 1rem; }
    .tp-stat .l { display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-faint); }
    .tp-stat .v { display: block; font-size: 1.5rem; font-weight: 800; color: var(--brand-dark); line-height: 1.3; }
    .tp-stat .v small { font-size: 0.9rem; color: var(--ink-faint); font-weight: 700; }
    .tp-stat .v.up { color: var(--brand); }
    .tp-stat-sub { display: block; font-size: 0.78rem; color: var(--ink-faint); font-weight: 600; }

    .tp-movers { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0.85rem; margin: 1.5rem 0 2.5rem; }
    .mover { border: 1px solid var(--line); border-radius: var(--radius); padding: 0.9rem 1rem; background: #fff; }
    .mover.up { border-left: 4px solid var(--brand); }
    .mover.down { border-left: 4px solid var(--danger); }
    .mover.neutral { border-left: 4px solid var(--accent); }
    .m-tag { display: block; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-faint); margin-bottom: 0.25rem; }
    .mover.up .m-tag { color: var(--brand-dark); }
    .mover.down .m-tag { color: var(--danger); }
    .mover.neutral .m-tag { color: var(--accent); }
    .mover a { font-weight: 800; font-size: 1.1rem; text-decoration: none; }
    .m-detail { display: block; font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.15rem; font-variant-numeric: tabular-nums; }

    .tp-note, .tp-disclaimer { color: var(--ink-soft); font-size: 0.95rem; max-width: var(--measure); }
    .tp-disclaimer { background: var(--accent-tint); border: 1px solid #ecd9b0; border-radius: var(--radius); padding: 0.9rem 1.1rem; }

    .tp-table-wrap { overflow-x: auto; margin: 1rem 0 2rem; }
    .tp-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; min-width: 720px; }
    .tp-table th { text-align: left; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-faint); border-bottom: 2px solid var(--line); padding: 0.6rem 0.7rem; white-space: nowrap; }
    .tp-table td { padding: 0.7rem 0.7rem; border-bottom: 1px solid var(--line); vertical-align: middle; }
    .tp-table tbody tr:hover { background: var(--bg-alt); }
    .c-rank { font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .rankmove { font-size: 0.68rem; font-weight: 800; margin-left: 0.25rem; }
    .rankmove.up { color: var(--brand); }
    .rankmove.down { color: var(--danger); }
    .c-firm a { font-weight: 700; text-decoration: none; }
    .mkt { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.15rem 0.45rem; border-radius: 999px; }
    .mkt-forex { background: var(--brand-tint); color: var(--brand-dark); }
    .mkt-futures { background: #e6eef7; color: #234b74; }
    .c-score { font-weight: 800; font-size: 1.05rem; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .c-score .s5 { font-size: 0.75rem; color: var(--ink-faint); font-weight: 600; }
    .c-delta { font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .c-delta.up { color: var(--brand); }
    .c-delta.down { color: var(--danger); }
    .c-delta.steady, .c-delta.new { color: var(--ink-faint); }
    .c-reviews { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .rev-delta { display: block; font-size: 0.75rem; color: var(--brand); font-weight: 700; }
    .trend { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; padding: 0.2rem 0.55rem; border-radius: 999px; white-space: nowrap; }
    .trend-up { background: var(--brand-tint); color: var(--brand-dark); }
    .trend-down { background: var(--danger-tint); color: var(--danger); }
    .trend-steady { background: var(--bg-alt); color: var(--ink-soft); }
    .trend-new { background: var(--accent-tint); color: #8a5e12; }
    .c-cta .view { font-weight: 700; font-size: 0.85rem; text-decoration: none; white-space: nowrap; }

    .tp-cards { list-style: none; padding: 0; margin: 1rem 0 2rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 0.85rem; }
    .tp-card { border: 1px solid var(--line); border-radius: var(--radius); background: #fff; padding: 1rem; }
    .tc-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
    .tc-name { font-weight: 800; text-decoration: none; font-size: 1.05rem; }
    .tc-score { display: flex; align-items: center; gap: 0.5rem; margin: 0.6rem 0; }
    .tc-score strong { font-size: 1.35rem; color: var(--brand-dark); font-variant-numeric: tabular-nums; }
    .tc-rev { font-size: 0.82rem; color: var(--ink-faint); }
    .stars { --pct: 96%; position: relative; display: inline-block; font-size: 1rem; letter-spacing: 1px; line-height: 1; color: var(--line); }
    .stars::before { content: '★★★★★'; position: absolute; top: 0; left: 0; width: var(--pct); overflow: hidden; color: #f5b301; white-space: nowrap; }
    .tc-link { display: inline-block; margin-top: 0.35rem; font-size: 0.85rem; font-weight: 700; text-decoration: none; }

    .tp-explainer { border-top: 1px solid var(--line); padding-top: 1.5rem; margin-top: 1rem; }
    .tp-explainer p { max-width: var(--measure); color: var(--ink-soft); }
    .tp-baseline { font-size: 0.9rem; border-left: 3px solid var(--line); padding-left: 0.85rem; }

    .tp-next { margin-top: 2.5rem; }

    @media (max-width: 640px) {
      .tp-hero { padding: 1.75rem 0 1.5rem; }
    }
  </style>
</Base>
