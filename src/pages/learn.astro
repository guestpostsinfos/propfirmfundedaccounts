  <script>
    type Firm = { name: string; daily: number | null; max: number; type: string; split: number; market: string };
    const FIRMS: Record<string, Firm> = {
      ftmo:            { name: 'FTMO', daily: 5, max: 10, type: 'static', split: 90, market: 'forex' },
      fundednext:      { name: 'FundedNext', daily: 5, max: 10, type: 'static', split: 90, market: 'forex' },
      fundingpips:     { name: 'FundingPips', daily: 4, max: 8, type: 'static', split: 80, market: 'forex' },
      the5ers:         { name: 'The5ers', daily: 5, max: 10, type: 'static', split: 80, market: 'forex' },
      e8:              { name: 'E8 Markets', daily: 5, max: 8, type: 'trailing', split: 90, market: 'forex' },
      alphacapital:    { name: 'Alpha Capital', daily: 4, max: 8, type: 'static', split: 80, market: 'forex' },
      topstep:         { name: 'Topstep', daily: null, max: 4, type: 'structured', split: 90, market: 'futures' },
      apex:            { name: 'Apex', daily: null, max: 8, type: 'trailing', split: 90, market: 'futures' },
      myfundedfutures: { name: 'MyFundedFutures', daily: null, max: 3, type: 'trailing', split: 90, market: 'futures' },
      takeprofittrader:{ name: 'Take Profit Trader', daily: null, max: 4, type: 'trailing', split: 80, market: 'futures' },
      other:           { name: 'your firm', daily: 5, max: 10, type: 'static', split: 80, market: 'forex' },
    };
    const TYPE_LABEL: Record<string, string> = {
      '2step': '2-Step Evaluation', '1step': '1-Step Evaluation', instant: 'Instant Funding', funded: 'Already Funded',
    };

    const $ = (id: string) => document.getElementById(id) as HTMLSelectElement;
    const money = (n: number) => '$' + Math.round(n).toLocaleString();

    function personalize() {
      const firm = FIRMS[$('pf-firm').value] || FIRMS.other;
      const type = $('pf-type').value;
      const size = parseFloat($('pf-size').value) || 100000;
      const targetPct = type === 'instant' || type === 'funded' ? 0 : 8;

      const set: Record<string, string> = {
        firm: firm.name,
        size: money(size),
        split: firm.split + '%',
        ddtype: firm.type,
        typelabel: TYPE_LABEL[type] || '',
        daily: firm.daily ? money(size * firm.daily / 100) : 'no daily limit',
        maxfloor: money(size - size * firm.max / 100),
        target: targetPct ? money(size * targetPct / 100) : 'none (already funded)',
        risk1: money(size * 0.01),
        risk05: money(size * 0.005),
        dailystop: firm.daily ? money(size * firm.daily / 100 * 0.4) : money(size * 0.02),
        takehome5: money(size * 0.05 * firm.split / 100),
        ddwarn: firm.type === 'trailing'
          ? 'Yours trails — treat every dollar of profit as a rising floor beneath you.'
          : firm.type === 'structured'
          ? 'Yours uses structured loss limits — check your dashboard for the exact figures.'
          : 'Yours is fixed, so profits give you a permanent cushion.',
      };

      document.querySelectorAll<HTMLElement>('[data-pv]').forEach((el) => {
        const k = el.getAttribute('data-pv')!;
        if (set[k] !== undefined) el.textContent = set[k];
      });

      const note = document.getElementById('pf-note')!;
      note.textContent =
        `Examples now use a ${money(size)} ${firm.name} ${TYPE_LABEL[type].toLowerCase()} account`
        + ` (${firm.type} drawdown, ${firm.split}% split).`;

      try { localStorage.setItem('pffa-learn', JSON.stringify({ f: $('pf-firm').value, t: type, s: size })); } catch (e) {}
    }

    ['pf-firm', 'pf-type', 'pf-size'].forEach((id) => $(id).addEventListener('change', personalize));

    // restore saved selections
    try {
      const saved = JSON.parse(localStorage.getItem('pffa-learn') || 'null');
      if (saved) {
        if (FIRMS[saved.f]) $('pf-firm').value = saved.f;
        if (TYPE_LABEL[saved.t]) $('pf-type').value = saved.t;
        const opt = [...$('pf-size').options].find((o) => o.value === String(saved.s));
        if (opt) $('pf-size').value = String(saved.s);
      }
    } catch (e) {}
    personalize();

    // ---- slide decks ----
    document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
      const slides = [...deck.querySelectorAll<HTMLElement>('.slide')];
      const count = deck.querySelector('.d-count')!;
      const prev = deck.querySelector('.d-prev') as HTMLButtonElement;
      const next = deck.querySelector('.d-next') as HTMLButtonElement;
      const dots = deck.querySelector('.dots')!;
      let i = 0;
      slides.forEach((_, idx) => {
        const b = document.createElement('button');
        b.setAttribute('aria-label', 'Go to slide ' + (idx + 1));
        b.addEventListener('click', () => show(idx));
        dots.appendChild(b);
      });
      const dotEls = [...dots.querySelectorAll('button')];
      function show(n: number) {
        i = Math.max(0, Math.min(slides.length - 1, n));
        slides.forEach((s, idx) => s.classList.toggle('active', idx === i));
        dotEls.forEach((d, idx) => d.classList.toggle('on', idx === i));
        count.textContent = (i + 1) + ' / ' + slides.length;
        prev.disabled = i === 0;
        next.disabled = i === slides.length - 1;
      }
      prev.addEventListener('click', () => show(i - 1));
      next.addEventListener('click', () => show(i + 1));
      show(0);
    });

    // ---- quizzes + score ----
    const quizzes = [...document.querySelectorAll<HTMLElement>('[data-quiz]')];
    let answered = 0, correct = 0;
    const badge = document.getElementById('score-badge')!;
    const finishMsg = document.getElementById('finish-msg')!;
    function updateScore() {
      badge.textContent = `Quiz score: ${correct} / ${answered}`;
      if (answered === quizzes.length) {
        const pct = Math.round((correct / quizzes.length) * 100);
        finishMsg.textContent =
          `You scored ${correct} / ${quizzes.length} (${pct}%). `
          + (pct === 100 ? 'Perfect — you understand the fundamentals. Time to apply them.'
            : pct >= 70 ? 'Strong grasp of the fundamentals — review any you missed, then apply them.'
            : 'Good start — revisit the modules you missed before risking a challenge fee.');
      }
    }
    quizzes.forEach((q) => {
      const opts = [...q.querySelectorAll<HTMLButtonElement>('.q-opt')];
      opts.forEach((opt) => opt.addEventListener('click', () => {
        if (q.classList.contains('answered')) return;
        q.classList.add('answered');
        const isRight = opt.dataset.correct === '1';
        opt.classList.add(isRight ? 'correct' : 'wrong');
        if (!isRight) q.querySelector<HTMLElement>('.q-opt[data-correct="1"]')!.classList.add('correct');
        q.querySelector<HTMLElement>('.q-explain')!.style.display = 'block';
        answered++; if (isRight) correct++;
        updateScore();
      }));
    });
  </script>
</Base>
